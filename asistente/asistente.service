[Unit]
Description=Asistente para mayores (MQTT + voz + botones)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
# Cambiá "pi" por tu usuario si elegiste otro en el Imager
User=pi
WorkingDirectory=/home/pi/AsistententeParaMayores-sebas/asistente
# Archivo opcional con MQTT_USER / MQTT_PASS (el "-" evita error si no existe)
EnvironmentFile=-/etc/asistente.env
ExecStart=/home/pi/venv-asistente/bin/python -u main.py
Restart=always
RestartSec=5
# Si el audio no suena como servicio pero sí a mano, probá descomentar:
#Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=multi-user.target
